{
  "name": "bufferednetworkrequest",
  "type": "module",
  "version": "1.1.6",
  "description": "Make your interfaces render ~30% faster on 3G using streams and partial JSON parsing.",
  "author": "barhatsor",
  "license": "MIT",
  "homepage": "https://github.com/barhatsor/BufferedNetworkRequest#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barhatsor/BufferedNetworkRequest.git"
  },
  "bugs": {
    "url": "https://github.com/barhatsor/BufferedNetworkRequest/issues"
  },
  "keywords": [
    "fetch",
    "network",
    "json",
    "response",
    "stream",
    "request"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:dev": "vitest --browser.headless=false",
    "coverage": "vitest run --project node --coverage",
    "typecheck": "tsc",
    "release": "bumpp",
    "demos:build": "tsdown --config demos/tsdown.config.ts",
    "demos:dev": "tsdown --config demos/tsdown.config.ts --watch"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "^5.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "bumpp": "^12.3.0",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-angular": "^9.4.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
